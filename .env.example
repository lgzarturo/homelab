# Configuración del homelab. `homelab up` crea .env a partir de este archivo si no existe.
# Después de editarlo, aplica los cambios con: homelab up

# Servicios que arrancan (quita los que no quieras, separados por coma).
COMPOSE_PROFILES=ollama,openwebui,speaches,n8n,filebrowser,portainer

# Desde dónde se entra a los paneles: 127.0.0.1 = solo este equipo, 0.0.0.0 = toda tu red local.
BIND_IP=127.0.0.1

# --- IA (Ollama) ---
# Núcleos para la IA: más núcleos = más tokens/s. El benchmark usa este valor como num_thread.
OLLAMA_CPUS=2
# Memoria máxima del contenedor de Ollama.
OLLAMA_MEM=6g
# Contexto por defecto en tokens: más contexto = más RAM.
OLLAMA_CTX=4096
# Dónde viven los modelos: un volumen de Docker (rápido en Mac/Windows) o una carpeta (ej. ./modelos).
OLLAMA_DATA=ollama_data
# Modelos que `homelab up` descarga si faltan (separados por coma).
OLLAMA_MODELS=qwen3.5:2b-q4_K_M,qwen3.5:4b-q4_K_M,gemma4:e2b-it-qat
# Cómo llega Open WebUI a Ollama. En Mac, Docker no usa la GPU (Metal): instala Ollama nativo,
# quita "ollama" de COMPOSE_PROFILES y usa http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# --- Voz (speaches) ---
# Whisper para oír. Con 32 GB o más prueba deepdml/faster-whisper-large-v3-turbo-ct2 (mejor español).
STT_MODEL=Systran/faster-whisper-small
# Voz para leer en voz alta y la voz en español a usar (ef_dora, em_alex).
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=ef_dora

# --- Límites de memoria de los demás servicios ---
OPENWEBUI_MEM=2g
# Whisper y Kokoro cargados a la vez ocupan ~1.8 GB: 3g deja margen para transcribir audios largos.
SPEACHES_MEM=3g

# --- Otros ---
# Zona horaria de n8n.
TZ=America/Bogota
# Usuario y grupo dueños de ./archivos (Filebrowser).
PUID=1000
PGID=1000
